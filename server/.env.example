# KisanQueue API Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real keys to version control.

# OpenAI API Key (server-side only — NEVER use VITE_ prefix)
OPENAI_API_KEY=your_openai_api_key_here
# Port for the API server (default: 3001)
PORT=3001

# Allowed origin for CORS (your Vite dev server)
CORS_ORIGIN=http://localhost:3000
